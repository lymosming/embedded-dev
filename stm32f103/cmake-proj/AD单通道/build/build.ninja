build myproject.elf: C_EXECUTABLE_LINKER__myproject.2eelf_ CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/misc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_adc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_bkp.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_can.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_cec.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_crc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_dac.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_dbgmcu.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_dma.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_exti.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_flash.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_fsmc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_gpio.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_i2c.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_iwdg.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_pwr.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_rcc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_rtc.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_sdio.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_spi.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_tim.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_usart.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/src/stm32f10x_wwdg.c.obj CMakeFiles/myproject.elf.dir/hal/STM32F10x_StdPeriph_Driver/system_stm32f10x.c.obj CMakeFiles/myproject.elf.dir/src/Hardware/AD.c.obj CMakeFiles/myproject.elf.dir/src/Hardware/OLED.c.obj CMakeFiles/myproject.elf.dir/src/System/Delay.c.obj CMakeFiles/myproject.elf.dir/src/main.c.obj CMakeFiles/myproject.elf.dir/src/stm32f10x_it.c.obj CMakeFiles/myproject.elf.dir/src/startup_stm32f10x_md.s.obj
  LINK_FLAGS = -mcpu=cortex-m3 -mthumb -Wl,--gc-sections --specs=nosys.specs --specs=nano.specs -T/Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/stm32f1x_64KB_flash.ld
  LINK_LIBRARIES = -lm
  OBJECT_DIR = CMakeFiles/myproject.elf.dir
  POST_BUILD = cd /Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build && arm-none-eabi-objcopy -O binary myproject.elf myproject.bin && arm-none-eabi-objcopy -O ihex myproject.elf myproject.hex && arm-none-eabi-size myproject.elf
  PRE_LINK = :
  TARGET_FILE = myproject.elf
  TARGET_PDB = myproject.elf.dbg


#############################################
# Utility command for flash

build flash: phony CMakeFiles/flash myproject.elf


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build && /usr/local/bin/ccmake -S/Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道 -B/Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = cd /Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build && /usr/local/bin/cmake --regenerate-during-build -S/Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道 -B/Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util


#############################################
# Custom command for CMakeFiles/flash

build CMakeFiles/flash | ${cmake_ninja_workdir}CMakeFiles/flash: CUSTOM_COMMAND myproject.elf || myproject.elf
  COMMAND = cd /Volumes/dev/www/embedded-dev/stm32f103/cmake-proj/AD单通道/build && st-flash write myproject.bin 0x08000000
  DESC = Flashing firmware to STM32 via ST-Link

